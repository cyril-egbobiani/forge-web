# Environment Configuration
# Backend base URL (Render live production backend)
# For a local backend, put VITE_API_BASE_URL=http://localhost:3000 in .env.local
# (git-ignored). Use the server root only; the app adds /api and /api/admin.
VITE_API_BASE_URL=https://forge-backend-hdvz.onrender.com
VITE_API_URL=https://forge-backend-hdvz.onrender.com/api/admin
